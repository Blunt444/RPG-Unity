  id: CaptainRenna-FirstMeet
  lines:
  - speaker: {fileID: 11400000, guid: f47ca4e4a39a1164a9eb7f58733efd57, type: 2}
    text: You are the one the king sent to fight off the threats.
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: 1
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 0
  - speaker: {fileID: 11400000, guid: f47ca4e4a39a1164a9eb7f58733efd57, type: 2}
    text: You look like a clown.
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: 2
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 0
  - speaker: {fileID: 11400000, guid: f47ca4e4a39a1164a9eb7f58733efd57, type: 2}
    text: Jokes aside. You need to kill the enemies in the path and report to me!
    topics: []
    quest: {fileID: 11400000, guid: 18c7fbdaf252e754ea3f9715191941de, type: 2}
    requiredActors: []
    rewards: []
    nextLineIndex: -1
    questAcceptNextLineIndex: 4
    questDeclineNextLineIndex: 5
    checkpointIndex: 2
  - speaker: {fileID: 11400000, guid: f47ca4e4a39a1164a9eb7f58733efd57, type: 2}
    text: Good work, I take my words back but not completely from my mind.
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: 6
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 3
  - speaker: {fileID: 11400000, guid: f47ca4e4a39a1164a9eb7f58733efd57, type: 2}
    text: Clear the road and report to me!
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: 3
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 4
  - speaker: {fileID: 11400000, guid: f47ca4e4a39a1164a9eb7f58733efd57, type: 2}
    text: Coward! you dont have a choice do as i say!
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: 2
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 0
  - speaker: {fileID: 11400000, guid: f47ca4e4a39a1164a9eb7f58733efd57, type: 2}
    text: Futher east, my army led by aldric got into trouble could you go there
      and help them!
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: 7
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 6
  - speaker: {fileID: 11400000, guid: f47ca4e4a39a1164a9eb7f58733efd57, type: 2}
    text: 'Hold on to your life while you travel. '
    topics: []
    quest: {fileID: 0}
