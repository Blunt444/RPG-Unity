    questDeclineNextLineIndex: 0
    checkpointIndex: 0
  - speaker: {fileID: 11400000, guid: 5a514978306f4b2409d70370a8d0ee24, type: 2}
    text: 'My troops sneaked in yesterday night and found the mine swarmed with enemies. '
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: 3
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 0
  - speaker: {fileID: 11400000, guid: 5a514978306f4b2409d70370a8d0ee24, type: 2}
    text: I don't want to send my man to death. So you got to go in alone.
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: 4
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 0
  - speaker: {fileID: 11400000, guid: 5a514978306f4b2409d70370a8d0ee24, type: 2}
    text: Defeat the enemies!
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: -1
    questAcceptNextLineIndex: 6
    questDeclineNextLineIndex: 5
    checkpointIndex: 0
  - speaker: {fileID: 11400000, guid: 5a514978306f4b2409d70370a8d0ee24, type: 2}
    text: As i said you can escape from me but not from the crown. They will hunt
      you down.
    topics: []
    quest: {fileID: 0}
    requiredActors: []
    rewards: []
    nextLineIndex: -1
    questAcceptNextLineIndex: 0
    questDeclineNextLineIndex: 0
    checkpointIndex: 0
  - speaker: {fileID: 11400000, guid: 5a514978306f4b2409d70370a8d0ee24, type: 2}
    text: Good, the mine 3 will eventually start to produce gold once again.
