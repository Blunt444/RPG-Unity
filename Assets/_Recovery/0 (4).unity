  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=140%><b>HOW TO PLAY</b></size>\r\n\r\n<b>MOVEMENT</b>\r\nUse <b>WASD</b>
    or <b>Arrow Keys</b> to move.\r\n\r\n<b>COMBAT</b>\r\nYou can fight as a <b>Warrior</b>
    or switch to <b>Archer</b> stance at any time.\r\nPress <b>Slash</b> to attack
    with your sword.\r\nPress <b>Guard</b> to block incoming attacks and negate damage.\r\nPress
    <b>Shoot</b> while in Archer stance to fire an arrow \u2014 aim with your mouse.\r\n\r\n<b>SWITCHING
    STANCES</b>\r\nPress the stance key to swap between Warrior and Archer.\r\nEach
    stance levels up separately, so both playstyles grow the more you use them.\r\n\r\n<b>QUESTS</b>\r\nTalk
    to NPCs to accept quests. Defeat enemies, collect items, or speak with\r\ncertain
    characters to complete them. Open your Quest Log to track progress\r\nand claim
    rewards.\r\n\r\n<b>SKILLS</b>\r\nEarn skill points by leveling up your Warrior
    or Archer stance. Spend them\r\nin the Skill Tree to unlock permanent upgrades.\r\n\r\n<b>SHOPS</b>\r\nVisit
    shopkeepers to buy supplies, arrows, and equipment using gold.\r\nGold is earned
    by defeating enemies and completing quests.\r\n\r\n<b>CHECKPOINTS</b>\r\nInteract
    with checkpoints to set your respawn point. If you fall in battle,\r\nyou'll
    return here.\r\n\r\n<b>SAVING</b>\r\nSave your progress anytime from the menu.
    You can keep multiple saves and\r\nload any of them from the Load Game screen.\r\n\r\nGood
    luck, and stay sharp out there."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1f6475bcfce324f478ca82f9c1b26521, type: 2}
  m_sharedMaterial: {fileID: 4746390704230687184, guid: 1f6475bcfce324f478ca82f9c1b26521, type: 2}
